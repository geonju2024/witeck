# 가상환경
venv/
__pycache__/
*.pyc

# 원본 영상 (약 1GB. GitHub 파일/저장소 용량 제한을 넘고, 인물이 식별되는 영상입니다)
videos/

# 랜드마크 중간 캐시 (16MB, 264개). videos/ 에서 재생성 가능하므로 제외.
landmarks/

# dataset.npz(4.4MB)와 labels.csv 는 커밋합니다.
# videos/ 를 올리지 않으므로, 이 둘이 없으면 README 의 수치를 재현할 수 없습니다.
# 공개 저장소로 전환할 경우 실명/생체 데이터가 포함된다는 점을 다시 검토하세요.
